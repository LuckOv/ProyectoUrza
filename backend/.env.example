# Clave de la API de Groq (obligatoria para conversar con el agente)
# Obtenela gratis en https://console.groq.com
GROQ_API_KEY=

# Clave de la API de Google Gemini (para el subagente de visión Karn: fotos de cartas y mesa de juego)
# Obtenela gratis en https://aistudio.google.com/
GEMINI_API_KEY=

# Clave de acceso a Mesa Central (panel del vendedor)
# Si no se configura, por defecto es 'urza'
VENDEDOR_CLAVE=urza

# Integración con Telegram (opcional pero recomendada)
# Token del bot creado con @BotFather en Telegram
# TELEGRAM_BOT_TOKEN=
# Tu ID numérico personal de Telegram (obtenelo hablando con @userinfobot) para recibir avisos y ser reconocido como dueño
# TELEGRAM_OWNER_ID=
# ID del grupo de la tienda en Telegram (opcional, ej. -100123456789)
# TELEGRAM_GRUPO_ID=

# Tokens opcionales
# PRICECHARTING_TOKEN=
# HF_TOKEN=
# CORS_ORIGENES=
